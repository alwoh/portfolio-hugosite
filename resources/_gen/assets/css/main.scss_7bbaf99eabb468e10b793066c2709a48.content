/* Navbar container */
.navbar {
  padding: 20px;
  background-color: #ffffff;
  /* Keeps background clean white like the image */ }

/* Flexbox layout to align items horizontally and wrap onto a new line if needed */
.nav-links {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8px;
  /* Subtle spacing around links and slashes */ }

/* Styling the individual links */
.nav-links a {
  text-decoration: none;
  color: #000000;
  /* Set to pure black as requested */
  font-weight: bold;
  font-size: 18px;
  letter-spacing: 0.5px;
  transition: color 0.2s ease-in-out; }

/* Optional: Subtle hover effect so users know it's clickable */
.nav-links a:hover {
  color: #555555; }

/* Styling the forward slash separators */
.separator {
  color: #000000;
  /* Keeps the slashes black */
  font-weight: bold;
  font-size: 18px;
  user-select: none;
  /* Prevents users from accidentally highlighting the slashes */ }

.navbar {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 10px 20px;
  height: 80px; }

.nav--list {
  width: 100%;
  list-style: none;
  display: flex;
  justify-content: flex-start;
  align-items: center; }

.item {
  position: relative;
  width: 100px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  margin: 0 30px;
  background: #1B1212;
  transform: translateZ(0) rotate(-30deg) skew(25deg) translate(0, 0);
  transition: transform 400ms linear; }

.item a {
  text-align: center;
  text-shadow: 2px 2px 1px #333;
  user-select: none;
  font-size: 16px;
  text-transform: uppercase;
  color: #E5E4E2;
  letter-spacing: 3px;
  z-index: 2;
  text-decoration: none;
  transform: translateZ(0) translate(0, 0);
  display: block; }

.item:hover {
  transform: translateZ(0) rotate(-30deg) skew(25deg) translate(10px, -10px); }

.item:before,
.item:after {
  content: "";
  position: absolute;
  left: -10px;
  background: #797979; }

.item:before {
  width: 15px;
  height: 100%;
  top: 0px;
  transform: translateZ(0) rotate(0deg) skewY(-45deg) translate(-5px, 2px); }

.item:after {
  width: 100%;
  height: 15px;
  top: 40px;
  transform: translateZ(0) rotate(0deg) skewX(-45deg) translate(2px, 0px); }

@media (max-width: 600px) {
  .navbar {
    display: none; } }

.oss {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-start;
  padding: 15px 0px 15px; }

.oss .oss-with-image {
  border: 1px solid #ddd;
  box-shadow: 3px 3px 3px #ddd;
  margin: 0.5%;
  padding: 0.5%;
  width: 400px;
  height: 300px; }

.oss .oss-without-image {
  border: 1px solid #ddd;
  box-shadow: 3px 3px 3px #ddd;
  margin: 0.5%;
  padding: 0.5%;
  width: 400px;
  height: 100px; }

.oss img {
  width: 100%;
  object-fit: contain; }

a.tag {
  background-color: #ddd;
  color: #333;
  display: inline-block;
  padding: 0.1em;
  font-size: 0.9em;
  text-decoration: none; }

.pagination {
  display: flex;
  justify-content: space-between;
  list-style: none;
  margin: 1rem auto;
  padding: 0; }

.pagination > .page-item {
  border: 1px solid #ddd;
  flex: 1;
  text-align: center;
  width: 5em; }

.pagination .page-link {
  display: block;
  color: #000;
  text-decoration: none; }

.pagination > .page-item.active {
  background-color: #333; }

.pagination > .page-item.active > .page-link {
  color: #fff; }

.pagination > .page-item.disabled > .page-link {
  color: #ddd; }

figure img {
  max-width: 100%;
  height: auto; }

@media only screen and (min-width: 768px) {
  .pagination {
    width: 30%; } }

@media only screen and (min-width: 768px) {
  .project-container {
    display: flex; }
  .project-container .project-list {
    width: 20%; }
  .project-container .project {
    flex: 1;
    padding-left: 1rem; } }

.roboto-condensed {
  font-family: "Roboto Condensed", sans-serif;
  font-optical-sizing: auto;
  font-weight: 400;
  font-style: normal; }

.roboto-h1 {
  font-family: "Roboto", sans-serif;
  font-optical-sizing: auto;
  font-weight: 700;
  font-style: normal;
  font-variation-settings: "wdth" 100;
  font-size: 2.5rem; }

.box {
  display: flex;
  align-items: stretch; }

.toggleDarkModeDiv {
  display: flex;
  gap: 0.5rem;
  flex-wrap: wrap;
  justify-content: center;
  margin-left: auto; }

.toggleDarkModeButton {
  margin: 0;
  padding: 7px;
  background: #23272a;
  color: #ffffff;
  border-radius: 4px;
  cursor: pointer; }

.darkmode {
  background: #181818;
  color: #eaeaea; }
  .darkmode nav, .darkmode footer {
    background: #23272a;
    color: #eaeaea; }
  .darkmode header, .darkmode .box, .darkmode .container {
    background: #242424;
    color: #eaeaea;
    border-radius: 8px; }
  .darkmode nav a {
    color: #eaeaea; }
  .darkmode .social-icons a {
    background: #23272a;
    color: #eaeaea; }
  .darkmode .toggleDarkModeButton {
    margin: 0;
    padding: 7px;
    color: #23272a;
    background-color: #ffffff;
    border-radius: 4px;
    cursor: pointer; }
  .darkmode a {
    color: #3dc3f8; }
  .darkmode a.tag {
    color: #ddd;
    background-color: #555454;
    display: inline-block;
    padding: 0.1em;
    font-size: 0.9em;
    text-decoration: none; }
