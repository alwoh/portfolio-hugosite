.social-icons {
  display: flex;
  gap: 0.5rem;
  flex-wrap: wrap;
  justify-content: center; }

.social-icons a {
  width: 36px;
  height: 36px;
  margin: 2px 4px; }

.social-icons svg {
  width: 100%;
  height: 100%; }

@media (max-width: 600px) {
  .header-flex {
    flex-direction: column;
    align-items: flex-start;
    margin: 10px 0px; }
  .social-icons {
    justify-content: flex-start;
    gap: 0.25rem; }
  .social-icons a {
    width: 28px;
    height: 28px;
    margin: 2px 2px; }
  .toggleDarkModeDiv {
    margin-right: auto;
    padding: 15px; } }

.header-flex {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 1rem;
  margin: 10px 0px; }

.header-flex h1 {
  margin: 0; }

.social-icons {
  display: flex;
  gap: 0.5rem; }

.social-icons a:hover svg {
  color: #d1d1d1;
  fill: #d1d1d1; }

.container {
  margin: 0 auto;
  width: 80%; }

nav {
  background-color: #fff; }

footer {
  background-color: #fff;
  color: #333;
  text-align: center; }

nav a {
  color: #fff;
  text-decoration: none;
  transition: color 0.2s;
  font-size: 1.25em;
  font-weight: 600; }

nav a:hover {
  color: #d1d1d1; }

footer {
  padding-top: 7px; }

